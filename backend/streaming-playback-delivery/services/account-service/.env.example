# Copy to .env (never commit it).
PORT=5001
NODE_ENV=development

# PostgreSQL (same credentials as INSTALLATION.md)
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/netflix

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Billing
PAST_DUE_GRACE_DAYS=7
RUN_RENEWAL_WORKER=true
RENEWAL_INTERVAL_MS=60000

# Comma-separated allowed origins for the frontend
CORS_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500
